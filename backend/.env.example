# Cấu hình backend — copy thành .env khi chạy local
APP_NAME=Tu Luyện Gym API
ENV=development

# URL frontend (thêm Vercel URL khi deploy)
CORS_ORIGINS=["http://localhost:3000"]

# Tuần 4: Discord webhook
DISCORD_WEBHOOK_URL=

# C.3: Gemini AI (aistudio.google.com — để trống là bỏ qua AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Tuần 2+: Supabase
SUPABASE_URL=
SUPABASE_KEY=
